<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JRTE.Core\JRTE.Core.csproj" />
    <ProjectReference Include="..\JRTE.Security\JRTE.Security.csproj" />
  </ItemGroup>

  <Target Name="CopyJRTEVideoEngine" AfterTargets="Build">
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\..\native\JRTE.VideoEngine\build-debug\JRTE.VideoEngine.dll"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(MSBuildProjectDirectory)\..\..\native\JRTE.VideoEngine\build-debug\JRTE.VideoEngine.dll')" />
  </Target>
</Project>
